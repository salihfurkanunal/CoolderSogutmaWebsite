# Copy to .env.local for local overrides. Never commit real secrets.
# .env* is already gitignored.

# Canonical site URL (no trailing slash). Used by sitemap, robots, Open Graph.
# Example: NEXT_PUBLIC_SITE_URL=https://www.ornek-domain.com
NEXT_PUBLIC_SITE_URL=NEXT_PUBLIC_SITE_URL=https://www.coolder.com.tr
